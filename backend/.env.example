# cp backend/.env.example backend/.env でコピーして使う
# 読み込み: docker compose の env_file（./backend/.env）と、go run 時の godotenv（カレントディレクトリの .env）
# 定義元: backend/pkg/config/config.go（api）、backend/cmd/migrate/main.go、backend/cmd/seed/main.go

# ===== 基本 =====
# 必須（未設定なら起動失敗）。api / migrate / seed が使う
DATABASE_URL=postgresql://user:password@host:5432/dbname
# 必須・32 バイト以上（不足なら起動失敗）。生成例: openssl rand -base64 48
JWT_SECRET=development-jwt-secret-minimum-32-bytes-long
# 必須（カンマ区切り。空なら起動失敗）
CORS_ORIGINS=http://localhost:4321
# 既定: 空（Domain 属性なし）。本番は API ホスト（例: api.satehits.com）
COOKIE_DOMAIN=
# 既定: 空。development なら Turnstile 検証をスキップする。docker compose は environment で上書きする
ENVIRONMENT=development
# ENVIRONMENT が development 以外なら必須（未設定なら起動失敗）
TURNSTILE_SECRET_KEY=your-turnstile-secret-key
# 既定: migrations（カレントディレクトリ基準）。migrate が使う
MIGRATIONS_DIR=migrations

# ===== メール（Outbox） =====
# 既定: 空（NoOp Sender）。ENVIRONMENT=production かつ OUTBOX_FLUSH_ENDPOINT_ENABLED=true なら必須
RESEND_API_KEY=
# 既定: さて、羊に戻るとしよう <noreply@satehits.com>
MAIL_FROM_ADDRESS=さて、羊に戻るとしよう <noreply@satehits.com>
# 既定: 20（正の整数）。1 回の flush で処理する最大件数
OUTBOX_BATCH_SIZE=20
# 既定: 120（正の整数）。1 回の flush の時間予算（秒）。Cloud Scheduler の attempt-deadline（180 秒）より短くする
OUTBOX_FLUSH_TIME_BUDGET_SECONDS=120
# 既定: false。true のときだけ POST /internal/outbox/flush を登録する（ローカルで make outbox-flush するには true）
OUTBOX_FLUSH_ENDPOINT_ENABLED=true

# ===== ログインのレートリミット =====
# 既定: 5（正の整数）。メールアドレス別の失敗上限
LOGIN_RATE_LIMIT_EMAIL_MAX=5
# 既定: 20（正の整数）。IP 別の失敗上限
LOGIN_RATE_LIMIT_IP_MAX=20
# 既定: 15（正の整数）。スライディングウィンドウの幅（分）
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
# 既定: 1（正の整数）。X-Forwarded-For の右から何段目をクライアント IP とするか（Cloud Run 直結なら 1）
TRUSTED_PROXY_HOPS=1

# ===== 画像ストレージ（S3 互換: 本番 Cloudflare R2 / ローカル MinIO） =====
# 任意。ENDPOINT / BUCKET / ACCESS_KEY / SECRET_KEY / PUBLIC_BASE_URL がすべて揃うと画像アップロードが有効（1 つでも欠けると NoOp）
STORAGE_ENDPOINT=http://minio:9000
# 既定: auto
STORAGE_REGION=auto
STORAGE_BUCKET=satehits-images
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_PUBLIC_BASE_URL=http://localhost:9000/satehits-images

# ===== 開発用シード =====
# make seed で必須（未設定なら seed が失敗）。api は読まない
SEED_ADMIN_PASSWORD=password123
