# backend/.env をコピーして使う: cp .env.example .env
# docker compose の env_file でも参照される

DATABASE_URL=postgresql://user:password@host:5432/dbname
# 32 バイト以上（例: openssl rand -base64 48）
JWT_SECRET=development-jwt-secret-minimum-32-bytes-long
CORS_ORIGINS=http://localhost:4321
# 開発時は空。本番は API ホスト（例: api.satehits.com）
COOKIE_DOMAIN=
TURNSTILE_SECRET_KEY=your-turnstile-secret-key
ENVIRONMENT=development

# 開発用シード（make seed）。本番では設定しない
SEED_ADMIN_PASSWORD=password123

# マイグレーション SQL ディレクトリ
MIGRATIONS_DIR=migrations
