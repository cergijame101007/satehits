# ===== Backend =====
DATABASE_URL=postgresql://user:password@host:5432/dbname
# 32 バイト以上（例: openssl rand -base64 48）
JWT_SECRET=development-jwt-secret-minimum-32-bytes-long
CORS_ORIGINS=http://localhost:4321
# 開発時は空。本番は API ホスト（例: api.satehits.com）
COOKIE_DOMAIN=
TURNSTILE_SECRET_KEY=your-turnstile-secret-key
ENVIRONMENT=development
RESEND_API_KEY=
MAIL_FROM_ADDRESS=さて、羊に戻るとしよう <noreply@satehits.com>
OUTBOX_BATCH_SIZE=20
# 1 回の flush の時間予算（秒）。Cloud Scheduler の attempt-deadline（180 秒）より短くする
OUTBOX_FLUSH_TIME_BUDGET_SECONDS=120
# ローカル開発では true。本番の公開 Cloud Run では false、private flush サービスでは true
OUTBOX_FLUSH_ENDPOINT_ENABLED=true

# ログイン失敗のレートリミット（スライディングウィンドウ）
LOGIN_RATE_LIMIT_EMAIL_MAX=5
LOGIN_RATE_LIMIT_IP_MAX=20
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
# Cloud Run 直結なら 1（X-Forwarded-For の右から何段目をクライアント IP とするか）
TRUSTED_PROXY_HOPS=1

# ===== 画像ストレージ（S3 互換: 本番 Cloudflare R2 / ローカル MinIO） =====
STORAGE_ENDPOINT=http://minio:9000
STORAGE_REGION=auto
STORAGE_BUCKET=satehits-images
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_PUBLIC_BASE_URL=http://localhost:9000/satehits-images

# ===== Frontend =====
PUBLIC_API_URL=http://localhost:8080
PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
