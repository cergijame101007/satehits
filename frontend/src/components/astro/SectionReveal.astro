---
interface Props {
  class?: string;
  delay?: number;
}

const { class: className = '', delay = 0 } = Astro.props;
---

<div
  class:list={['section-reveal', className]}
  style={delay ? `--reveal-delay: ${delay}s` : undefined}
>
  <slot />
</div>

<style>
  .section-reveal {
    opacity: 0;
    transform: translateY(40px);
    transition:
      opacity 0.8s cubic-bezier(0.25, 0.1, 0.25, 1),
      transform 0.8s cubic-bezier(0.25, 0.1, 0.25, 1);
    transition-delay: var(--reveal-delay, 0s);
  }
  .section-reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<script>
  function initReveal() {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { rootMargin: '-100px' }
    );

    document.querySelectorAll('.section-reveal:not(.is-visible)').forEach((el) => {
      observer.observe(el);
    });
  }

  initReveal();
  document.addEventListener('astro:page-load', initReveal);
</script>
