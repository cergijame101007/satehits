---
/**
 * プレビュー用の注意表示。
 * inline: 固定ヘッダー内（帯＋ナビの高さが自動で揃う）
 * static: 管理画面など文書フロー先頭
 */
interface Props {
  variant?: 'inline' | 'static';
}

const { variant = 'static' } = Astro.props;

const root =
  variant === 'inline'
    ? 'w-full min-w-0 max-w-full shrink-0 bg-amber-600 text-white shadow-sm border-b border-amber-800/15 overflow-x-hidden'
    : 'w-full min-w-0 max-w-full bg-amber-600 text-white shadow-sm border-b border-amber-800/15 overflow-x-hidden';
---

<div class:list={[root]} role="status" aria-live="polite">
  <!-- モバイル: 高さを抑えた短文 -->
  <div class="md:hidden px-4 py-1.5">
    <p class="text-xs font-semibold leading-tight text-balance">
      見本サイトです（本番の予約・お預かりはありません）
    </p>
    <p class="mt-0.5 text-[11px] leading-snug text-white/95 text-pretty">
      お名前・電話・メール・予約・ログインは店に届きません。画面は自由に開いて大丈夫です。
    </p>
  </div>

  <!-- タブレット以上: 従来の説明 -->
  <div class="hidden md:block px-6 py-2">
    <p class="text-sm leading-relaxed max-w-4xl mx-auto text-pretty">
      <span class="font-semibold">プレビュー用の見本サイトです。</span>
      本番の予約やお客様情報の保存はありません。お名前・電話・メール・予約やログインの内容は、お店のシステムには届かず保存もされません。画面の見え方や操作感の確認だけなので、ページは自由に開いて大丈夫です。
    </p>
  </div>
</div>
