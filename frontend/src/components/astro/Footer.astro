---
const currentYear = new Date().getFullYear();

const socialLinks = [
  {
    name: 'Instagram',
    href: 'https://www.instagram.com/satehits/',
    icon: 'instagram',
  },
];

const footerLinks = [
  { href: '/reservation', label: '予約する' },
  { href: '/suppliers', label: 'お取り引き先' },
];
---

<footer class="bg-primary text-white">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-16">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-12">
      <!-- Brand -->
      <div class="space-y-4">
        <h3 class="text-xl font-medium">さて、羊に戻るとしよう</h3>
        <p class="text-white/70 text-sm leading-relaxed">
          和紅茶とお野菜と富山湾の幸<br />
          小麦・乳製品・卵・添加物不使用の<br />
          体に優しいお昼ごはん
        </p>
      </div>

      <!-- Store Info -->
      <div class="space-y-4">
        <h4 class="text-sm font-medium uppercase tracking-wider text-white/80">Store Info</h4>
        <div class="text-sm text-white/70 space-y-2">
          <p>〒933-0871</p>
          <p>富山県高岡市駅南5丁目4-7</p>
          <p>WINE LAB内</p>
          <div class="pt-2">
            <p>月火水 11:30 - 15:00 (LO 14:00)</p>
            <p>土日祝 8:30 - 15:00 (LO 14:00)</p>
            <p class="text-white/50">定休日: 木・金</p>
          </div>
        </div>
      </div>

      <!-- Links & Social -->
      <div class="space-y-4">
        <h4 class="text-sm font-medium uppercase tracking-wider text-white/80">Links</h4>
        <nav class="flex flex-col space-y-2">
          {footerLinks.map((link) => (
            <a
              href={link.href}
              class="text-sm text-white/70 hover:text-white transition-colors"
            >
              {link.label}
            </a>
          ))}
        </nav>
        
        <div class="pt-4">
          <h4 class="text-sm font-medium uppercase tracking-wider text-white/80 mb-3">Follow Us</h4>
          <div class="flex space-x-4">
            {socialLinks.map((social) => (
              <a
                href={social.href}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center justify-center w-10 h-10 rounded-full bg-white/10 hover:bg-white/20 transition-colors"
                aria-label={social.name}
              >
                {social.icon === 'instagram' && (
                  <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                  </svg>
                )}
              </a>
            ))}
          </div>
          <p class="text-sm text-white/70 mt-3">@satehits</p>
        </div>
      </div>
    </div>

    <!-- Copyright -->
    <div class="mt-12 pt-8 border-t border-white/10">
      <p class="text-center text-sm text-white/50">
        &copy; {currentYear} さて、羊に戻るとしよう All rights reserved.
      </p>
    </div>
  </div>
</footer>
