---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/astro/Header.astro';
import Footer from '../components/astro/Footer.astro';
import SupplierList from '../components/react/SupplierList.tsx';
---

<BaseLayout title="お取り引き先 | さて、羊に戻るとしよう">
  <Header isTransparent={false} />

  <main class="pt-36 md:pt-44 pb-16 px-4">
    <div class="max-w-2xl mx-auto">
      <!-- ヘッダー -->
      <div class="mb-8">
        <a
          href="/"
          class="inline-flex items-center gap-1 text-sm text-primary/70 hover:text-primary transition-colors mb-4"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
          戻る
        </a>
        <h1 class="text-2xl font-medium tracking-wide">お取り引き先</h1>
      </div>

      <!-- 紹介文 -->
      <p class="text-sm leading-relaxed text-gray-600 mb-8">
        当店は、富山県内の素晴らしい生産者の皆様に支えられています。
      </p>

      <div class="w-full h-px bg-gray-200 mb-8"></div>

      <SupplierList client:visible />

      <div class="w-full h-px bg-gray-200 my-8"></div>

      <!-- フッター案内 -->
      <div class="text-center space-y-2">
        <p class="text-sm text-gray-600">
          お取り引きに関するお問い合わせは<br />
          Instagramへお願いいたします。
        </p>
        <a
          href="https://www.instagram.com/satehits/"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 text-sm text-primary hover:text-primary-dark transition-colors"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z" />
          </svg>
          @satehits
        </a>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
