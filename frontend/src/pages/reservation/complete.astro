---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/astro/Header.astro';
import Footer from '../../components/astro/Footer.astro';
---

<BaseLayout title="予約申請完了 | さて、羊に戻るとしよう">
  <Header isTransparent={false} />

  <main class="pt-24 pb-16 px-4">
    <div class="max-w-lg mx-auto text-center">
      <!-- チェックマークアイコン -->
      <div class="w-20 h-20 rounded-full bg-green-100 flex items-center justify-center mx-auto mb-6 animate-fade-in">
        <svg class="w-10 h-10 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
        </svg>
      </div>

      <h1 class="text-2xl font-medium mb-2 animate-fade-in-up">予約申請を受け付けました</h1>
      <p class="text-gray-500 text-sm mb-8">ありがとうございます</p>

      <!-- 予約情報サマリー -->
      <div id="reservation-summary" class="rounded-xl border border-gray-200 bg-white p-6 text-left mb-8 animate-fade-in-up" style="animation-delay: 0.2s;">
        <div class="space-y-3 text-sm" id="summary-content">
          <!-- JSで動的に表示 -->
        </div>
      </div>

      <!-- 注意事項 -->
      <div class="rounded-xl bg-amber-50 border border-amber-200 p-5 text-left mb-8 animate-fade-in-up" style="animation-delay: 0.3s;">
        <p class="text-sm font-medium text-amber-800 mb-2">オーナーが確認後、承認・拒否をご連絡いたします。</p>
        <div class="text-sm text-amber-700 space-y-1">
          <p class="font-medium mt-3">キャンセルポリシー</p>
          <ul class="list-disc list-inside space-y-1 text-xs">
            <li>キャンセルは前日までにご連絡ください</li>
            <li>当日キャンセルは100%のキャンセル料が発生します</li>
          </ul>
        </div>
      </div>

      <!-- Instagram連絡先 -->
      <p class="text-sm text-gray-500 mb-6">
        変更・キャンセルは Instagram へご連絡ください<br />
        <a
          href="https://www.instagram.com/satehits/"
          target="_blank"
          rel="noopener noreferrer"
          class="text-primary-link font-medium hover:underline"
        >
          @satehits
        </a>
      </p>

      <!-- トップに戻るボタン -->
      <a
        href="/"
        class="inline-block w-full max-w-xs py-3 rounded-xl bg-primary-btn text-white font-medium hover:bg-primary-btn-hover transition-colors shadow-lg"
      >
        トップに戻る
      </a>
    </div>
  </main>

  <Footer />
</BaseLayout>

<script>
  // sessionStorage から予約情報を取得して表示
  const data = sessionStorage.getItem('reservation_complete');
  const container = document.getElementById('summary-content');

  if (data && container) {
    const info = JSON.parse(data);
    container.innerHTML = `
      <div class="flex justify-between py-2 border-b border-gray-100">
        <span class="text-gray-500">来店日</span>
        <span class="font-medium">${info.visit_date}</span>
      </div>
      <div class="flex justify-between py-2 border-b border-gray-100">
        <span class="text-gray-500">時間</span>
        <span class="font-medium">${info.visit_time}</span>
      </div>
      <div class="flex justify-between py-2 border-b border-gray-100">
        <span class="text-gray-500">人数</span>
        <span class="font-medium">${info.people}名</span>
      </div>
      <div class="flex justify-between py-2">
        <span class="text-gray-500">お名前</span>
        <span class="font-medium">${info.name} 様</span>
      </div>
    `;
    sessionStorage.removeItem('reservation_complete');
  } else if (container) {
    container.innerHTML = '<p class="text-gray-400 text-center py-4">予約情報を取得できませんでした</p>';
  }
</script>

<style>
  .text-primary-link {
    color: #43676B;
  }
  .bg-primary-btn {
    background-color: #43676B;
  }
  .bg-primary-btn-hover {
    background-color: #365558;
  }
</style>
