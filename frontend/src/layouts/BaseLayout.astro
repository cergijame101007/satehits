---
import { getImage } from 'astro:assets';
import '../styles/global.css';
import heroImage from '../assets/images/top-view-high.jpg';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'さて、羊に戻るとしよう - 和紅茶とお野菜と富山湾の幸' } = Astro.props;

// OGP 用に原寸 (約 4MB) ではなく縮小した JPEG を出す
const ogImage = await getImage({ src: heroImage, width: 1200, format: 'jpg' });
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/images/top-icon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    
    <!-- OGP -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage.src} />
    
    <title>{title}</title>
  </head>
  <body class="min-h-screen flex flex-col">
    <slot />
  </body>
</html>
