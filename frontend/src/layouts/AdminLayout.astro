---
import '../styles/global.css';
import { PENDING_LIST_HREF, pendingBadgeClassName } from '@/lib/pendingReservations';

interface Props {
  title: string;
}

const { title } = Astro.props;

const navItems = [
  { href: '/admin/reservations', label: '予約一覧', pendingBadge: true },
  { href: '/admin/reservations/new', label: '予約登録' },
  { href: '/admin/schedules', label: 'スケジュール' },
  { href: '/admin/suppliers', label: '取引先' },
];

/*
 * 未対応 pending 件数バッジ。件数はクライアントで取得し、0 件・取得失敗時は hidden のまま。
 * 数字は aria-hidden にし、読み上げは sr-only の「未対応の予約 N 件」に任せる。
 * バッジ自体を全期間の申請中一覧へのリンクにするため、文字リンクとは分けて隣に置く（入れ子の a は作れない）
 */
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/images/top-icon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} | 管理画面</title>
  </head>
  <body class="min-h-screen bg-bg-light">
    <header class="bg-primary text-white shadow-sm">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between h-14 gap-3">
        <a
          href="/admin"
          class="text-sm font-medium hover:opacity-80 transition-opacity truncate min-w-0"
        >
          さて、羊に戻るとしよう - 管理画面
        </a>

        <nav class="hidden md:flex items-center gap-4 text-sm shrink-0">
          {navItems.map((item) => (
            <span class="inline-flex items-center whitespace-nowrap">
              <a href={item.href} class="hover:opacity-80 transition-opacity">
                {item.label}
              </a>
              {item.pendingBadge && (
                <a href={PENDING_LIST_HREF} data-pending-badge hidden class="hover:opacity-80 transition-opacity">
                  <span
                    data-pending-badge-count
                    aria-hidden="true"
                    class:list={[pendingBadgeClassName, 'text-[11px]']}
                  ></span>
                  <span data-pending-badge-label class="sr-only"></span>
                </a>
              )}
            </span>
          ))}
          <button
            type="button"
            class="admin-logout-btn px-3 py-1 border border-white/40 rounded text-xs hover:bg-white/10 transition-colors whitespace-nowrap"
          >
            ログアウト
          </button>
        </nav>

        <button
          id="admin-mobile-menu-btn"
          type="button"
          class="md:hidden flex items-center justify-center w-10 h-10 shrink-0 text-white"
          aria-label="メニューを開く"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>
    </header>

    <div
      id="admin-mobile-menu"
      class="admin-mobile-menu fixed inset-0 z-[100] md:hidden flex flex-col items-center justify-center"
    >
      <button
        id="admin-mobile-menu-close"
        type="button"
        class="absolute top-4 right-4 w-10 h-10 flex items-center justify-center text-white"
        aria-label="メニューを閉じる"
      >
        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"
          ></path>
        </svg>
      </button>

      <nav class="flex flex-col items-center gap-6 text-center">
        {navItems.map((item) => (
          <span class="inline-flex items-center whitespace-nowrap">
            <a
              href={item.href}
              class="text-xl font-medium text-white/90 hover:text-white transition-colors admin-mobile-nav-link"
            >
              {item.label}
            </a>
            {item.pendingBadge && (
              <a
                href={PENDING_LIST_HREF}
                data-pending-badge
                hidden
                class="admin-mobile-nav-link text-white/90 hover:text-white transition-colors"
              >
                <span
                  data-pending-badge-count
                  aria-hidden="true"
                  class:list={[pendingBadgeClassName, 'text-xs']}
                ></span>
                <span data-pending-badge-label class="sr-only"></span>
              </a>
            )}
          </span>
        ))}
        <div class="w-10 h-px my-1 bg-white/30"></div>
        <button
          type="button"
          class="admin-logout-btn px-8 py-3 border border-white/60 rounded-full text-sm text-white hover:bg-white/10 transition-colors"
        >
          ログアウト
        </button>
      </nav>
    </div>

    <main class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <slot />
    </main>

    <script>
      import { UnauthorizedError } from '@/lib/api';
      import { ensureAccessToken, logout } from '@/lib/auth';
      import {
        fetchActionablePendingCount,
        formatBadgeCount,
        pendingBadgeLabel,
        subscribePendingCountRefresh,
      } from '@/lib/pendingReservations';

      let latestPendingRequest = 0;

      /* 取得失敗時はバッジを出さない（ページ表示自体は妨げない）。後から始めた取得の結果を優先する */
      async function updatePendingBadges() {
        const request = ++latestPendingRequest;
        let count = 0;
        try {
          count = await fetchActionablePendingCount();
        } catch (err) {
          // ログイン画面へリダイレクト中はログを出さない
          if (!(err instanceof UnauthorizedError)) {
            console.error('未対応予約件数の取得に失敗しました', err);
          }
        }
        if (request !== latestPendingRequest) return;

        document.querySelectorAll<HTMLElement>('[data-pending-badge]').forEach((badge) => {
          const countEl = badge.querySelector('[data-pending-badge-count]');
          const labelEl = badge.querySelector('[data-pending-badge-label]');
          if (countEl) countEl.textContent = formatBadgeCount(count);
          if (labelEl) labelEl.textContent = pendingBadgeLabel(count);
          badge.hidden = count === 0;
        });
      }

      ensureAccessToken().then(
        () => {
          void updatePendingBadges();
          // ステータス更新後・bfcache 復帰時に取り直す
          subscribePendingCountRefresh(() => {
            void updatePendingBadges();
          });
        },
        () => {
          window.location.href = '/admin/login';
        },
      );

      document.querySelectorAll('.admin-logout-btn').forEach((btn) => {
        btn.addEventListener('click', async () => {
          try {
            await logout();
          } finally {
            window.location.href = '/admin/login';
          }
        });
      });

      const mobileMenuBtn = document.getElementById('admin-mobile-menu-btn');
      const mobileMenuClose = document.getElementById('admin-mobile-menu-close');
      const mobileMenu = document.getElementById('admin-mobile-menu');

      function openMenu() {
        mobileMenu?.classList.add('is-open');
        document.documentElement.style.overflow = 'hidden';
      }

      function closeMenu() {
        mobileMenu?.classList.remove('is-open');
        document.documentElement.style.overflow = '';
      }

      mobileMenuBtn?.addEventListener('click', openMenu);
      mobileMenuClose?.addEventListener('click', closeMenu);

      document.querySelectorAll('.admin-mobile-nav-link').forEach((link) => {
        link.addEventListener('click', closeMenu);
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && mobileMenu?.classList.contains('is-open')) {
          closeMenu();
        }
      });
    </script>
  </body>
</html>

<style>
  .admin-mobile-menu {
    background-color: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.35s ease,
      visibility 0.35s ease;
    overscroll-behavior: contain;
    touch-action: none;
  }

  .admin-mobile-menu.is-open {
    opacity: 1;
    visibility: visible;
  }
</style>
