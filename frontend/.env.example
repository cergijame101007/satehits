# cp frontend/.env.example frontend/.env でコピーして使う
# Astro（Vite）は frontend/ 直下の .env 系ファイルを読む。PUBLIC_ で始まる変数だけがクライアントに公開される
# 本番・プレビューの値は Cloudflare Pages の環境変数に設定する（docs/deploy_cloud_run.md §3 (8)）

# バックエンド API のベース URL
PUBLIC_API_URL=http://localhost:8080
# Cloudflare Turnstile のサイトキー
PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
